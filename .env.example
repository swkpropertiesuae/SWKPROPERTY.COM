# Copy to .env.local for local development. In production set these on the Cloudflare Worker:
#   public values  -> wrangler.jsonc "vars" or Workers Builds environment variables (needed at build time)
#   secrets        -> `npx wrangler secret put NAME`

# --- Lead delivery (at least one channel; R2 archive via the MEDIA binding is always attempted) ---
LEAD_WEBHOOK_URL=            # HTTPS CRM / Zapier / Make / n8n webhook that receives every enquiry as JSON
LEAD_WEBHOOK_SECRET=         # optional, sent as Bearer token + X-SWK-Signature-256 HMAC-SHA256 (secret)
RESEND_API_KEY=              # optional, emails each lead via resend.com (secret)
LEAD_EMAIL_TO=leads@example.com               # comma-separated recipient emails
LEAD_EMAIL_FROM="Website <leads@example.com>" # must be a Resend-verified domain

# --- Analytics & ads (loaded in Google Consent Mode v2 — denied by default until consent) ---
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# --- Search engine / platform verification meta tags ---
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
NEXT_PUBLIC_YANDEX_VERIFICATION=
NEXT_PUBLIC_FACEBOOK_DOMAIN_VERIFICATION=
